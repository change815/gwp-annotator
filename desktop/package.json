{
  "name": "gwp-annotator-desktop",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "smoke": "node scripts/static-smoke.mjs",
    "check:node": "node scripts/check-node-version.mjs",
    "preinstall": "node scripts/check-node-version.mjs",
    "rust:bootstrap": "sh scripts/bootstrap-local-rust.sh",
    "rust:fmt": "sh scripts/with-local-rust.sh cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:clippy": "sh scripts/with-local-rust.sh cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "sh scripts/with-local-rust.sh cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:build": "sh scripts/with-local-rust.sh cargo build --manifest-path src-tauri/Cargo.toml",
    "rust:check:windows": "sh scripts/check-windows-target.sh",
    "tauri:package": "sh scripts/with-local-tauri.sh build --bundles app"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
